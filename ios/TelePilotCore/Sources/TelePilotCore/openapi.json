                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "服务器内部错误"
          }
        },
        "security": [
          {
            "AuthCookie": []
          }
        ],
        "summary": "Get Account",
        "tags": [
          "accounts"
        ]
      }
    },
