            "name": "aid",
            "required": true,
            "schema": {
              "title": "Aid",
              "type": "integer"
            }
          },
          {
            "in": "cookie",
            "name": "auth_token",
            "required": false,
            "schema": {
              "title": "Auth Token",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
