    "securitySchemes": {
      "AuthCookie": {
        "description": "Web 登录后由服务端写入的 HttpOnly Cookie。",
        "in": "cookie",
        "name": "auth_token",
        "type": "apiKey"
      },
      "CsrfCookie": {
        "description": "写请求 double-submit CSRF Cookie。",
        "in": "cookie",
        "name": "csrf_token",
        "type": "apiKey"
      },
      "CsrfHeader": {
        "description": "必须与 csrf_token Cookie 相同。",
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "RequestedWith": {
        "description": "Web/PWA 写请求固定为 telepilot-ui。",
        "in": "header",
        "name": "X-Requested-With",
        "type": "apiKey"
      },
      "WebhookToken": {
        "description": "外部 Webhook 投递使用的账号级 Token。",
        "in": "header",
        "name": "X-TelePilot-Webhook-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "TelePilot",
    "version": "0.106.0-beta.5"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "get": {
        "description": "列出全部账号。",
        "operationId": "list_accounts_api_accounts_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "auth_token",
            "required": false,
            "schema": {
              "title": "Auth Token",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountSummary"
                  },
                  "title": "Response List Accounts Api Accounts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "认证失败"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "服务器内部错误"
          }
        },
        "security": [
          {
            "AuthCookie": []
          }
        ],
        "summary": "List Accounts",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/accounts/{aid}": {
      "get": {
        "description": "读取账号详情。",
