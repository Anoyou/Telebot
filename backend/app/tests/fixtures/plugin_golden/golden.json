                "type": "string"
              },
              "response_text": {
                "default": "你好，交互 Bot",
                "title": "示例文案",
                "type": "string"
              }
            },
            "type": "object"
          },
          "interaction_profile": "utility_trigger",
          "key": "start_with_interaction",
          "launch_mode": "hybrid",
          "message_channels": {
            "admin_command": "userbot_reply",
            "public_keyword": "interaction_bot"
          },
          "money_channel": "userbot_reply",
          "payload_contract": {
            "required_envelope": [
              "source",
              "actor",
              "trigger",
              "session"
            ],
            "required_event_fields": [
              "type",
              "chat_id"
            ]
          },
          "preserve_command_trigger": true,
          "result_contract": {
            "actions": [
              "send_message",
              "result",
              "end_session"
            ]
          },
          "session_scope": "chat",
          "settlement": {
            "mode": "announce_only",
            "winner_field": "actor.user_id"
          },
          "title": "开始示例"
        }
      ],
      "lint": [],
      "metadata": {
        "agent_tools": [],
        "author": "TelePilot",
        "capabilities": {
          "telegram_native_raw": {
            "enabled": false,
