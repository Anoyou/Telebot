          },
          "description": "演示交互 Bot 入口与原命令双兼容。",
          "dispatch_modes": [
            "admin_command",
            "public_keyword"
          ],
          "events": [
            "keyword",
            "message",
            "session_close"
          ],
          "input_schema": {
            "additionalProperties": false,
            "properties": {
              "message": {
                "default": "你好，交互 Bot",
                "deprecated": true,
                "description": "历史字段名会与标准事件信封 payload.message 冲突，请改用 response_text。",
