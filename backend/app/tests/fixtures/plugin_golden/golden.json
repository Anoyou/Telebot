    "event_bus_demo": {
      "interaction_entries": [],
      "lint": [],
      "metadata": {
        "agent_tools": [],
        "author": "examples",
        "capabilities": {
          "telegram_direct_passthrough": {
            "directions": [
              "incoming"
            ],
            "enabled": false,
            "reason": "示例插件不启用低延时直通；只有抢红包、秒杀等需要跳过标准链路的插件才应声明并让账号二次手动开启。",
            "sources": [
              "userbot"
            ]
          },
          "telegram_native_raw": {
            "enabled": true,
            "reason": "只在排查 Telegram 原生字段映射差异时读取 native_raw_meta；业务逻辑仍以标准事件信封为主。",
            "sources": [
              "interaction_bot",
              "userbot"
            ],
            "store_payload": false
          }
        },
        "category": "interactive",
        "config_actions": [],
        "config_schema": null,
        "description": "演示最终版 Event Bus、Trace 与 MessageOps 插件契约。",
        "display_name": "Event Bus 示例",
        "entry": "plugin.py",
        "event_subscriptions": [
          {
            "events": [
              "message",
              "command"
            ],
            "scope": "all_allowed_chats",
            "source": [
              "userbot",
              "interaction_bot"
            ]
          },
          {
            "events": [
              "callback_query"
            ],
            "scope": "all_allowed_chats",
            "source": [
              "interaction_bot"
            ]
          },
          {
            "events": [
              "inline_query",
              "chosen_inline_result"
            ],
            "scope": "inline_all",
            "source": [
              "interaction_bot"
            ]
          },
          {
            "events": [
              "guest_message"
            ],
            "scope": "guest_all",
            "source": [
              "interaction_bot"
            ]
          },
          {
            "events": [
              "payment_confirmed"
            ],
            "scope": "rule_bound",
            "source": [
              "external_payment_notice",
              "userbot"
            ]
          }
        ],
        "interaction_entries": [],
        "interaction_profile": "utility_trigger",
        "min_telebot_version": null,
        "min_telepilot_version": "0.72.0-beta.2",
        "name": "event_bus_demo",
        "permissions": [
          "send_message",
          "read_chat"
        ],
        "plugin_api": null,
        "requires_platform_capabilities": [
          "interaction_bot"
        ],
        "tags": [],
        "usage": "安装后在插件中心启用；Event Bus 会按 event_subscriptions 投递 message、command、callback_query、inline_query、chosen_inline_result、guest_message（访客模式）与 payment_confirmed。插件只读取标准事件信封，发送、按钮 ACK、inline answer、访客回复与 settlement 都返回 MessageOps/action。",
        "version": "0.1.0"
      }
    },
