    {
      "id": "config-list",
      "x_ui_widget": "config-list",
      "applies_to": [
        "array<object>"
      ],
      "match": "",
      "summary": "对象列表：每项一行摘要，点开编辑；可启停、排序、增删",
      "keys": [
        "x-ui-title-field",
        "x-ui-description-field",
        "x-ui-summary",
        "x-ui-enabled-field",
        "x-ui-reorderable",
        "x-ui-add-label"
      ],
      "ios_since": "0.14.0",
      "fallback": "readonly",
      "example": {
        "key": "rules",
        "schema": {
          "type": "array",
          "title": "规则",
          "x-ui-widget": "config-list",
          "x-ui-title-field": "name",
          "x-ui-summary": "{keyword} → {reply}",
          "x-ui-enabled-field": "enabled",
          "x-ui-add-label": "添加规则",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "title": "名称"
              },
              "enabled": {
                "type": "boolean",
                "title": "启用",
                "default": true
              },
              "keyword": {
                "type": "string",
                "title": "关键词"
              },
              "reply": {
                "type": "string",
                "title": "回复"
              }
            }
          }
        }
      }
    },
