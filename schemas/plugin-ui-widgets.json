      "mode": "async",
      "timeout_ms": 10000,
      "returns": "None",
      "summary": "保存成功后后台调用，不影响保存结果"
    },
    "on_ui_card": {
      "mode": "sync",
      "timeout_ms": 3000,
      "returns": "dict（卡片数据）"
    },
    "on_ui_action": {
      "mode": "sync",
      "timeout_ms": 10000,
      "returns": "{message?, refresh?: bool}"
    }
