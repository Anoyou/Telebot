  "keys": [
    {
      "key": "x-ui-mode",
      "scope": "schema",
      "type": "string",
      "enum": [
        "rules",
        "single",
        "schema",
        "platform"
      ],
      "summary": "配置入口形态（顶层）"
    },
    {
      "key": "x-ui-widget",
      "scope": "field",
      "type": "string",
      "summary": "显式指定控件，取值见 widgets[].x_ui_widget"
    },
    {
      "key": "x-ui-hidden",
      "scope": "field",
      "type": "boolean",
      "summary": "不显示该字段"
    },
    {
      "key": "x-ui-section",
      "scope": "field",
      "type": "string",
      "summary": "所属分组标题"
    },
    {
      "key": "x-ui-section-inline",
      "scope": "field",
      "type": "boolean",
      "summary": "长配置页里该分组留在顶层"
    },
    {
      "key": "x-ui-order",
      "scope": "field",
      "type": "number",
      "summary": "字段排序"
    },
    {
      "key": "x-ui-property-order",
      "scope": "schema",
      "type": "array<string>",
      "summary": "properties 声明顺序（宿主自动生成）"
    },
    {
      "key": "x-ui-columns",
      "scope": "field",
      "type": "integer",
      "summary": "Web 分组列数（1–3），iOS 忽略"
    },
    {
      "key": "x-ui-placeholder",
      "scope": "field",
      "type": "string",
      "summary": "输入提示"
    },
    {
      "key": "x-ui-provider-field",
      "scope": "field",
      "type": "string",
      "summary": "llm-model-select 同时写回的供应商字段"
