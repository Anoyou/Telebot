{
  "$comment": "TelePilot 插件声明式 UI 契约（规范来源）。Web ConfigDialog / PluginCards 与 iOS ManagementPluginConfigView / PluginCardsView 都据此实现并在单测中逐项校验；副本由 scripts/sync-plugin-ui-widgets.py 生成，不要手改副本。",
  "contract_version": 1,
  "unknown_widget": {
    "policy": "readonly",
    "message": "此控件需要更新 App",
    "summary": "客户端遇到不认识的 x-ui-widget（或本契约未列出的控件）时显示「此控件需要更新 App」并保持只读，不退化成通用编辑器，避免把数据改坏。"
  },
  "resolution_order": [
    "hidden",
    "preview",
    "placeholders",
    "readonly",
    "llm-provider-select",
    "llm-model-select",
    "dynamic-select",
    "config-list",
    "agent-skill-multi-select",
    "allowed-peer-multi-select",
    "multi-select",
    "list-select",
    "secret-list",
    "select",
    "switch",
    "number",
    "object",
    "json-object",
    "json-array",
    "string-list",
    "secret",
    "textarea",
    "text"
  ],
  "widgets": [
    {
      "id": "hidden",
      "x_ui_widget": null,
      "applies_to": [
        "any"
      ],
      "match": "x-ui-hidden 为 true",
      "summary": "不显示（x-ui-hidden: true），值原样保留",
      "keys": [
        "x-ui-hidden"
      ],
      "ios_since": "0.13.0",
      "fallback": "hidden",
      "example": {
        "key": "internal_state",
        "schema": {
          "type": "string",
          "x-ui-hidden": true
        }
      }
    },
    {
      "id": "preview",
      "x_ui_widget": null,
      "applies_to": [
        "string"
      ],
      "match": "字段名 template_preview 或 *_preview",
      "summary": "只读的 Telegram HTML 预览（字段名为 template_preview 或以 _preview 结尾）",
      "keys": [],
      "ios_since": "0.13.0",
      "fallback": "readonly",
      "example": {
        "key": "usage_preview",
        "schema": {
          "type": "string",
          "title": "命令说明"
        }
      }
    },
    {
      "id": "placeholders",
      "x_ui_widget": null,
      "applies_to": [
        "string"
      ],
      "match": "字段名 template_placeholders",
      "summary": "只读的模板占位符说明（字段名 template_placeholders）",
      "keys": [],
      "ios_since": "0.13.0",
      "fallback": "readonly",
      "example": {
        "key": "template_placeholders",
        "schema": {
          "type": "string",
          "title": "占位符"
        }
      }
    },
    {
      "id": "readonly",
      "x_ui_widget": null,
      "applies_to": [
        "any"
      ],
      "match": "readOnly 为 true",
      "summary": "只读展示（readOnly: true，插件自动维护）",
      "keys": [],
      "ios_since": "0.13.0",
      "fallback": "readonly",
      "example": {
        "key": "last_sync_at",
        "schema": {
          "type": "string",
          "title": "最近同步",
          "readOnly": true
        }
      }
    },
    {
      "id": "llm-provider-select",
