    {
      "key": "x-ui-model-modality",
      "scope": "field",
      "type": "string",
      "summary": "llm-model-select 只列此模态的模型（text / image）"
    },
    {
      "key": "x-ui-options-field",
      "scope": "field",
      "type": "string",
      "summary": "dynamic-select 的选项来源字段"
    },
    {
      "key": "x-ui-title-field",
      "scope": "field",
      "type": "string",
      "summary": "config-list 每项标题取自的子字段"
    },
    {
      "key": "x-ui-description-field",
      "scope": "field",
      "type": "string",
      "summary": "config-list 每项副标题取自的子字段"
    },
    {
      "key": "x-ui-summary",
      "scope": "field",
      "type": "string",
      "summary": "config-list 每项摘要模板，{子字段} 占位"
