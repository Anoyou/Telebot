    {
      "key": "x-secret-list",
      "scope": "field",
      "type": "object",
      "summary": "密钥列表声明 {secret_field, note_field?, id_field?, legacy_field?}；宿主遮罩、按 id 保留原值并加密"
    },
    {
      "key": "x-config-actions",
      "scope": "schema",
      "type": "array<object>",
      "summary": "配置动作（也可写在 manifest config_actions）"
    },
    {
      "key": "x-usage-guide",
      "scope": "schema",
      "type": "any",
      "summary": "使用说明"
    }
  ],
  "secret_list": {
    "defaults": {
      "note_field": "note",
      "id_field": "secret_id"
    },
    "mask": "前 4 位…后 4 位（不足 12 位只显示 •）",
    "summary": "读取时 secret_field 变成遮罩并附 id_field；保存时 id 或遮罩命中已保存的条目就保留原密钥，否则当作新明文；legacy_field 里按行 / 逗号分隔的旧密钥并入列表后清空。"
  },
  "cards": {
    "slots": [
      {
        "id": "plugin.overview",
        "summary": "插件详情顶部（Web 插件中心详情 / iOS 插件详情）",
        "context": [
          "plugin_key"
        ]
      },
      {
        "id": "account.detail",
        "summary": "账号详情（只显示在该账号启用的插件的卡片）",
        "context": [
          "plugin_key",
          "account_id"
        ]
      },
      {
        "id": "dashboard",
        "summary": "概览末尾（全局启用的插件）",
        "context": [
          "plugin_key"
        ]
      }
    ],
    "layouts": [
      {
        "type": "stats",
        "summary": "一排关键数字",
        "fields": {
          "items": "[{label, path | value, format?, tone?, unit?}]"
        },
        "example": {
          "type": "stats",
          "items": [
            {
              "label": "调用",
              "path": "calls"
            },
            {
              "label": "失败",
              "path": "failed",
              "tone": "danger"
            }
          ]
        },
        "example_data": {
          "calls": 12,
          "failed": 1
        }
      },
      {
        "type": "kv",
        "summary": "键值行",
        "fields": {
          "items": "[{label, path | value, format?}]"
        },
        "example": {
          "type": "kv",
          "items": [
            {
              "label": "最近运行",
              "path": "last_at",
              "format": "relative_time"
            }
          ]
        },
        "example_data": {
          "last_at": 1767225600
        }
      },
      {
        "type": "table",
        "summary": "表格（手机上每行折成一张小卡）",
        "fields": {
          "rows_path": "数据里行数组的路径（默认 rows）",
          "columns": "[{key, label, format?}]",
          "empty": "空表文案"
        },
        "example": {
          "type": "table",
          "rows_path": "rows",
          "columns": [
            {
              "key": "name",
              "label": "名称"
            },
            {
              "key": "count",
